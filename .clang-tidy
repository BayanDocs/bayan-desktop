# Static analysis for bayan-desktop's C++ code, run by the `tidy` target (cmake/BayanLint.cmake) with the pinned clang-tidy. Every finding is an error.
# Disabled checks, and why:
#   bugprone-easily-swappable-parameters: flags most functions that take two numbers or two strings.
#   cppcoreguidelines-avoid-magic-numbers, readability-magic-numbers: the stub's test page is defined by literal geometry and colours.
#   cppcoreguidelines-pro-type-vararg: Qt's logging functions (qInfo, qCritical) are printf-style.
#   cppcoreguidelines-avoid-do-while: Qt Test's macros expand to do-while loops.
#   cppcoreguidelines-avoid-const-or-ref-data-members: objects that work on behalf of another one keep a reference to it on purpose.
#   cppcoreguidelines-non-private-member-variables-in-classes, misc-non-private-member-variables-in-classes: plain data structs.
#   misc-include-cleaner: does not understand Qt's convenience headers.
#   modernize-use-trailing-return-type: a style choice the project does not make.
#   portability-avoid-pragma-once: every compiler BayanDocs supports (GCC, Clang, MSVC) understands #pragma once.
#   readability-identifier-length: short names such as x and y are clearer in geometry code.
#   readability-redundant-access-specifiers: Qt needs "private slots:" next to "private:".
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-avoid-const-or-ref-data-members,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  misc-*,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,
  modernize-*,
  -modernize-use-trailing-return-type,
  portability-*,
  -portability-avoid-pragma-once,
  performance-*,
  readability-*,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-redundant-access-specifiers
WarningsAsErrors: '*'
# Only our own C++ headers: never files that Qt generates in the build directory, and not the engine's C header (bayan_ffi.h), which must
# stay valid C and is generated by cbindgen in bayan-core once CORE-007 lands.
HeaderFilterRegex: '.*/(src|tests)/.*'
ExcludeHeaderFilterRegex: '.*/[^/]*_autogen/.*|.*/bayan_ffi\.h'
SystemHeaders: false
